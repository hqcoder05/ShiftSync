# Public host addresses used by clients outside Docker.
# Set EXPO_HOST_IP to the LAN IP of the Docker host (not localhost)
# when scanning the Expo QR code from a physical phone.
EXPO_HOST_IP=192.168.x.x

BACKEND_PORT=8080
WEB_PORT=3000
WEB_PUBLIC_API_URL=http://localhost:8080/api
MOBILE_PUBLIC_API_URL=http://192.168.x.x:8080/api

DB_PUBLIC_PORT=5432
REDIS_PUBLIC_PORT=6379
DB_NAME=shiftsync
DB_USER=postgres
DB_PASSWORD=change-me-for-local-use
JWT_SECRET=change-me-to-a-long-local-development-secret
JWT_EXPIRATION_MS=86400000

# Optional Expo host port overrides.
EXPO_PORT=8081
EXPO_DEVTOOLS_PORT=19000
EXPO_LAN_PORT=19001
EXPO_TUNNEL_PORT=19002
