# Copy this file to .env. Never commit the generated values.
DB_NAME=shiftsync
DB_USER=postgres
# Generate with: openssl rand -base64 32
DB_PASSWORD=replace-with-a-unique-database-password
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional local demo data
# Use `prod,demo` only with a disposable local database. The demo profile seeds a fixed, idempotent sample store.
# SPRING_PROFILES_ACTIVE=prod,demo
