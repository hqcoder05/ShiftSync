flowchart LR
  M[Manager]:::actor
  A[Admin]:::actor
  S[Staff]:::actor
  subgraph SHIFT[Shift management]
    C((Create shift)):::uc
    R((Configure shift requirements)):::uc
    P((Publish shifts)):::uc
    AS((Assign staff to shift)):::uc
    RM((Remove staff assignment)):::uc
    SW((Request or manage shift swap)):::uc
    V((View own shifts)):::uc
  end
  M --- C
  A --- C
  M --- R
  A --- R
  M --- P
  A --- P
  M --- AS
  A --- AS
  M --- RM
  A --- RM
  S --- SW
  M --- SW
  A --- SW
  S --- V
  C -.->|precedes| R
  R -.->|precedes| P
  AS -.->|creates assignment; not ShiftStatus| V
  classDef actor fill:#fff3cd,stroke:#8a6d3b,color:#222
  classDef uc fill:#e8f1ff,stroke:#356ac3,color:#222
